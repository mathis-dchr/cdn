frr version 10.2.1_git
frr defaults traditional
hostname r1
domainname localdomain
no ipv6 forwarding
!
interface eth1
 description vers r2-ca:eth1
 ip address 10.10.1.1/24
exit
!
interface eth2
 description vers r2-fr:eth1
 ip address 20.10.1.1/24
exit
!
interface eth3
 description vers r2-jp:eth1
 ip address 30.10.1.1/24
exit
!
router bgp 10
 bgp router-id 10.255.0.1
 no bgp default ipv4-unicast
 neighbor 10.10.1.2 remote-as 1020
 neighbor 10.10.1.2 description r2-ca
 neighbor 20.10.1.2 remote-as 2020
 neighbor 20.10.1.2 description r2-fr
 neighbor 30.10.1.2 remote-as 3020
 neighbor 30.10.1.2 description r2-jp
 !
 address-family ipv4 unicast
  network 10.10.1.0/24
  network 20.10.1.0/24
  network 30.10.1.0/24
  neighbor 10.10.1.2 activate
  neighbor 10.10.1.2 route-map RM-IN in
  neighbor 10.10.1.2 route-map RM-OUT out
  neighbor 20.10.1.2 activate
  neighbor 20.10.1.2 route-map RM-IN in
  neighbor 20.10.1.2 route-map RM-OUT out
  neighbor 30.10.1.2 activate
  neighbor 30.10.1.2 route-map RM-IN in
  neighbor 30.10.1.2 route-map RM-OUT out
 exit-address-family
exit
!
route-map RM-IN permit 10
exit
!
route-map RM-OUT permit 10
exit
!
